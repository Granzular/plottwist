# Generate a local value with:
# uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Put the generated value in quotes below. Never commit your .env file.
DJANGO_SECRET_KEY=

# Development only. Default is False when this variable is absent.
DJANGO_DEBUG=True

# Comma-separated hostnames, without schemes or ports.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Reuse an existing GROQ_API_KEY from your environment. Uncomment only if you
# choose to supply a local key here; never commit the populated .env file.
# GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=30
# Use json_object for models without strict JSON Schema support.
GROQ_RESPONSE_FORMAT=json_schema

# Child Python process timeout, including imports and PNG rendering.
EXECUTION_TIMEOUT_SECONDS=60

# Private run results and downloads expire after this many seconds.
ARTIFACT_TTL_SECONDS=900
